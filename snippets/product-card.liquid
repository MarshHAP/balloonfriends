<a class="product-card" href="{{ card_product.url }}">
  <div class="product-card__media">
    {%- if card_product.featured_image -%}
      <img src="{{ card_product.featured_image | image_url: width: 700 }}" alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}" loading="lazy" width="700" height="700">
    {%- else -%}
      <span aria-hidden="true">🎈</span>
    {%- endif -%}
  </div>
  <div class="product-card__title">{{ card_product.title }}</div>
  <div class="product-card__price">
    {%- if card_product.price_varies -%}From {% endif -%}
    {{ card_product.price_min | money }}
  </div>
</a>
