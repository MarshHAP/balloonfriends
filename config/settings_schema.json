[
  {
    "name": "theme_info",
    "theme_name": "Balloon Friends",
    "theme_version": "1.0.0",
    "theme_author": "Balloon Friends",
    "theme_documentation_url": "https://github.com/MarshHAP/balloonfriends",
    "theme_support_url": "https://github.com/MarshHAP/balloonfriends"
  },
  {
    "name": "Branding",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "Balloon Friends",
        "info": "Shown in the header, footer, and page titles."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text / ink",
        "default": "#2E2A39"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#6D388B"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_bg_soft",
        "label": "Soft background",
        "default": "#F6F4F9"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale / savings",
        "default": "#DD1D1D"
      }
    ]
  },
  {
    "name": "Bundle offer",
    "settings": [
      {
        "type": "range",
        "id": "bundle_size",
        "label": "Bundle size (buy N)",
        "min": 2,
        "max": 6,
        "step": 1,
        "default": 3
      },
      {
        "type": "range",
        "id": "bundle_free",
        "label": "Free items per bundle",
        "min": 1,
        "max": 3,
        "step": 1,
        "default": 1
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      }
    ]
  }
]
