<div class="hero {% if section.settings.image != blank %}hero--has-image{% endif %}">
  {%- if section.settings.image != blank -%}
    <div class="hero__image">
      <img
        src="{{ section.settings.image | image_url: width: 1600 }}"
        srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1000 }} 1000w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2200 }} 2200w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" loading="eager" fetchpriority="high" width="2000" height="1100">
    </div>
    <div class="hero__overlay"></div>
  {%- else -%}
    <span class="hero__balloon" style="top:12%;left:8%;">🎈</span>
    <span class="hero__balloon" style="top:58%;left:14%;font-size:3.6rem;animation-delay:1.2s;">🐶</span>
    <span class="hero__balloon" style="top:18%;right:10%;font-size:4.4rem;animation-delay:2s;">🦄</span>
    <span class="hero__balloon" style="top:62%;right:16%;font-size:3.8rem;animation-delay:0.6s;">🦖</span>
  {%- endif -%}

  <div class="hero__inner page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    <p class="hero__sub">{{ section.settings.subheading }}</p>
    <div class="hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '/products/balloon-friend' }}" class="btn btn--large">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a href="{{ section.settings.button2_link | default: '#bundle' }}" class="btn btn--large btn--outline">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

<div class="trust-strip">
  <span>⭐️⭐️⭐️⭐️⭐️ Loved by 2,000+ families</span>
  <span>🚚 Tracked shipping</span>
  <span>🛡 30-day guarantee</span>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The original walking balloon pet" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bouncy Walks, Bigger Smiles" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Meet Balloon Friend™ — the inflatable pet that trots along on its own little legs wherever your child goes."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Build a Bundle — 3 for £19.99" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
