{%- assign product = all_products[section.settings.product] -%}

<div class="section" id="shop">
  <div class="page-width">
    <div class="section__heading animate-in">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>

    {%- if product != blank and product.variants.size > 0 -%}
      <div class="featured-bundle__grid">
        <div class="featured-bundle__media animate-in">
          {%- if section.settings.image != blank -%}
            <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            srcset="{{ section.settings.image | image_url: width: 400 }} 400w, {{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 989px) 100vw, 55vw"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" loading="lazy" width="1200" height="1200">
          {%- elsif product.featured_image -%}
            <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="1200" height="1200">
          {%- else -%}
            <span aria-hidden="true">🐶🎈</span>
          {%- endif -%}
        </div>
        <div class="animate-in">
          {% render 'bundle-buy-box', product: product %}
        </div>
      </div>
    {%- else -%}
      <p style="text-align:center;">Select a product for this section in the theme editor.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured bundle",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Section image (defaults to product image)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mix & match — any 3 for £19.99" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build Your Balloon Bundle" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Fifteen adorable friends to choose from. Pick any three for just £19.99 — the discount applies automatically at checkout."
    }
  ],
  "presets": [{ "name": "Featured bundle" }]
}
{% endschema %}
