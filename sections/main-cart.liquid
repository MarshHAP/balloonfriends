<div class="section">
  <div class="page-width">
    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        <h1>Your basket is empty</h1>
        <p>Your new best friend is waiting for you.</p>
        <a href="{{ all_products['balloon-friend'].url | default: routes.all_products_collection_url }}" class="btn btn--large">Shop Balloon Friends</a>
      </div>
    {%- else -%}
      <h1>Your basket</h1>

      {%- assign bf_qty = 0 -%}
      {%- for item in cart.items -%}
        {%- if item.product.handle == 'balloon-friend' -%}
          {%- assign bf_qty = bf_qty | plus: item.quantity -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign bundle_size = settings.bundle_size | default: 3 -%}
      {%- if bf_qty > 0 and bf_qty < bundle_size -%}
        {%- assign missing = bundle_size | minus: bf_qty -%}
        <div class="form-status form-status--error" style="background:rgba(var(--color-accent),0.08);color:rgb(var(--color-accent));">
          🎈 Add {{ missing }} more Balloon Friend{% if missing > 1 %}s{% endif %} to get one <strong>FREE</strong> — <a href="{{ all_products['balloon-friend'].url }}#bundle" style="color:inherit;">complete your bundle</a>.
        </div>
      {%- elsif bf_qty >= bundle_size -%}
        <div class="form-status form-status--success">🎉 Bundle complete — your discount is applied automatically at checkout.</div>
      {%- endif -%}

      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <table class="cart-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Quantity</th>
              <th style="text-align:right;">Total</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <div class="cart-item__row">
                    <div class="cart-item__img">
                      {%- if item.image -%}
                        <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="72" height="72">
                      {%- else -%}
                        🎈
                      {%- endif -%}
                    </div>
                    <div>
                      <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                      {%- unless item.product.has_only_default_variant -%}
                        <div class="cart-item__variant">{{ item.variant.title }}</div>
                      {%- endunless -%}
                      <a class="cart-item__remove" href="{{ item.url_to_remove }}">Remove</a>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="qty-input" data-cart-qty data-line="{{ forloop.index }}">
                    <button type="button" data-dir="down" aria-label="Decrease quantity">&minus;</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity">
                    <button type="button" data-dir="up" aria-label="Increase quantity">+</button>
                  </div>
                </td>
                <td style="text-align:right;">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <s style="color:rgba(var(--color-ink),0.45);">{{ item.original_line_price | money }}</s>
                    <strong style="color:rgb(var(--color-sale));">{{ item.final_line_price | money }}</strong>
                  {%- else -%}
                    {{ item.final_line_price | money }}
                  {%- endif -%}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart-footer">
          <div class="cart-summary">
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="cart-summary__row" style="color:rgb(var(--color-sale));">
                  <span>{{ discount.title }}</span>
                  <span>-{{ discount.total_allocated_amount | money }}</span>
                </div>
              {%- endfor -%}
            {%- endif -%}
            <div class="cart-summary__row">
              <strong>Subtotal</strong>
              <strong>{{ cart.total_price | money }}</strong>
            </div>
            <p class="cart-summary__note">Taxes included. Shipping calculated at checkout.</p>
            <button type="submit" name="checkout" class="btn btn--full btn--large">Checkout — {{ cart.total_price | money }}</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
