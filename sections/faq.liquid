<div class="section" id="faq">
  <div class="page-width">
    <div class="section__heading animate-in">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="faq animate-in">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does the 3 for £19.99 offer work?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add any three Balloon Friends to your basket — mix and match any styles — and you pay just £19.99, saving £9.98 automatically at checkout. No code needed.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How does the 3 for £19.99 offer work?", "answer": "<p>Add any three Balloon Friends to your basket — mix and match any styles — and you pay just £19.99, saving £9.98 automatically at checkout. No code needed.</p>" } },
        { "type": "question", "settings": { "question": "How does it walk?", "answer": "<p>Each Balloon Friend comes with clip-on legs and weighted feet. Once inflated, hold the lead and it trots along beside your child as they walk.</p>" } },
        { "type": "question", "settings": { "question": "What age is it suitable for?", "answer": "<p>Balloon Friends are designed for children aged 3 and up, with adult supervision for younger ones.</p>" } },
        { "type": "question", "settings": { "question": "How long does it stay inflated?", "answer": "<p>Made from tough, durable material — far thicker than a party balloon — your friend stays bouncy for weeks and can be re-inflated any time.</p>" } },
        { "type": "question", "settings": { "question": "What if my child doesn't love it?", "answer": "<p>Every order is covered by our 30-day money-back guarantee. If you're not happy, we'll refund you in full — no questions asked.</p>" } }
      ]
    }
  ]
}
{% endschema %}
